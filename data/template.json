:focus, textarea:focus { outline: none; }\n    ::-webkit-scrollbar { width: 8px; height: 8px; }\n    ::-webkit-scrollbar-thumb { background: var(--line-strong); border-radius: 4px; }\n    ::-webkit-scrollbar-track { background: transparent; }\n    input[type=range] { -webkit-appearance: none; appearance: none; height: 4px; background: var(--line); border-radius: 999px; cursor: pointer; }\n    input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--ink); border: 2px solid #fff; box-shadow: 0 1px 3px rgba(0,0,0,.2); cursor: grab; }\n    input[type=range]::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--ink); border: 2px solid #fff; box-shadow: 0 1px 3px rgba(0,0,0,.2); cursor: grab; border: none; }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }\n    .fade-in { animation: fadeIn .25s ease both; }\n  </style>\n</head>\n<body>\n<div id=\"root\" style=\"min-height:100vh;display:flex;align-items:center;justify-content:center;\">\n  <div style=\"text-align:center;padding:40px;color:#6b5b48;font-family:'Inter',sans-serif;\">\n    <div style=\"width:32px;height:32px;border:2.5px solid #e6dec9;border-top-color:#2b2118;border-radius:50%;margin:0 auto 16px;animation:spin 1s linear infinite\"></div>\n    <div style=\"font-size:14px;font-weight:600;letter-spacing:.5px\">Chargement…</div>\n  </div>\n</div>\n\n<script type=\"text/babel\">\nconst { useState, useRef, useEffect, useCallback, useMemo } = React;\n\n/* ───────────────────── Helpers ───────────────────── */\nfunction hexPath(cx, cy, r) {\n  const pts = [];\n  for (let i = 0; i < 6; i++) { const a = Math.PI/3*i - Math.PI/6; pts.push([cx+r*Math.cos(a), cy+r*Math.sin(a)]); }\n  return pts.map((p,i)=>`${i===0?\"M\":\"L\"}${p[0]},${p[1]}`).join(\" \")+\"Z\";\n}\n\nasync function svgToPngBytes(svgEl, size) {\n  const clone = svgEl.cloneNode(true);\n  clone.setAttribute(\"width\", size); clone.setAttribute(\"height\", size);\n  // Inject embedded font CSS so non-system fonts (Cinzel, Stardos Stencil, etc) render correctly\n  const css = await getEmbeddedFontCSS();\n  if (css) {\n    const styleEl = document.createElementNS(\"http://www.w3.org/2000/svg\", \"style\");\n    styleEl.textContent = css;\n    clone.insertBefore(styleEl, clone.firstChild);\n  }\n  const str = new XMLSerializer().serializeToString(clone);\n  const canvas = document.createElement(\"canvas\"); canvas.width=size; canvas.height=size;\n  const ctx = canvas.getContext(\"2d\");\n  return new Promise((res,rej)=>{\n    const img = new Image();\n    const url = URL.createObjectURL(new Blob([str],{type:\"image/svg+xml;charset=utf-8\"}));\n    img.onload = ()=>{ ctx.drawImage(img,0,0,size,size); URL.revokeObjectURL(url); canvas.toBlob(async b=>res(new Uint8Array(await b.arrayBuffer())),\"image/png\"); };\n    img.onerror=rej; img.src=url;\n  });\n}\n\n/* Read @font-face rules from already-loaded stylesheets (works offline AFTER the bundler\n   has inlined the Google Fonts stylesheet, since the woff2 url() refs become data: URIs). */\nlet _fontCssPromise = null;\nfunction getEmbeddedFontCSS() {\n  if (_fontCssPromise) return _fontCssPromise;\n  _fontCssPromise = (async () => {\n    // Make sure fonts are ready first (so document.fonts reflects loaded faces)\n    try { if (document.fonts && document.fonts.ready) await document.fonts.ready; } catch {}\n    const out = [];\n    for (const sheet of Array.from(document.styleSheets)) {\n      let rules;\n      try { rules = sheet.cssRules; } catch { continue; }\n      if (!rules) continue;\n      for (const rule of Array.from(rules)) {\n        if (rule.type === CSSRule.FONT_FACE_RULE) out.push(rule.cssText);\n      }\n    }\n    if (out.length) return out.join(\"\\n\");\n    // Fallback (online only): fetch directly\n    try {\n      const url = \"https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800&family=Special+Elite&family=Stardos+Stencil:wght@400;700&family=Oswald:wght@600;700&family=Ultra&display=swap\";\n      const css = await fetch(url).then(r=>r.text());\n      const urls = [...new Set([...css.matchAll(/url\\((https:[^)]+)\\)/g)].map(m=>m[1]))];\n      const map = {};\n      await Promise.all(urls.map(async u => {\n        try {\n          const blob = await fetch(u).then(r=>r.blob());\n          map[u] = await new Promise((res,rej)=>{ const fr=new FileReader(); fr.onload=()=>res(fr.result); fr.onerror=rej; fr.readAsDataURL(blob); });\n        } catch {}\n      }));\n      return css.replace(/url\\((https:[^)]+)\\)/g, (_, u) => `url(${map[u] || u})`);\n    } catch (e) { return \"\"; }\n  })();\n  return _fontCssPromise;\n}\n\n/* ───────────────────── Data ───────────────────── */\nconst STATUSES = [\"APPROUVÉ\",\"VALIDÉ\",\"CONFIDENTIEL\",\"URGENT\",\"ORIGINAL\",\"REFUSÉ\",\"REÇU\",\"PAYÉ\"];\nconst SHAPES   = [\n  {id:\"circle\",    label:\"Cercle\"},\n  {id:\"rectangle\", label:\"Rectangle\"},\n  {id:\"hexagon\",   label:\"Hexagone\"},\n  {id:\"diamond\",   label:\"Losange\"},\n];\nconst FONTS = [\n  {label:\"Sans\",        value:\"Inter, sans-serif\"},\n  {label:\"Cinzel\",      value:\"'Cinzel', Georgia, serif\",       hint:\"Sceau légal\"},\n  {label:\"Stencil\",     value:\"'Stardos Stencil', Impact, sans-serif\", hint:\"Pochoir / douane\"},\n  {label:\"Typewriter\",  value:\"'Special Elite', 'Courier New', monospace\", hint:\"Machine à écrire\"},\n  {label:\"Oswald\",      value:\"'Oswald', Impact, sans-serif\",  hint:\"Condensé moderne\"},\n  {label:\"Ultra\",       value:\"'Ultra', 'Bookman', serif\",     hint:\"Slab puissant\"},\n];\nconst COLORS = [\n  {label:\"Rouge\", border:\"#c0392b\", text:\"#c0392b\", bg:\"rgba(192,57,43,0.08)\"},\n  {label:\"Bleu\",  border:\"#1a3c8f\", text:\"#1a3c8f\", bg:\"rgba(26,60,143,0.08)\"},\n  {label:\"Vert\",  border:\"#1a7a4a\", text:\"#1a7a4a\", bg:\"rgba(26,122,74,0.08)\"},\n  {label:\"Violet\",border:\"#6d28d9\", text:\"#6d28d9\", bg:\"rgba(109,40,217,0.08)\"},\n  {label:\"Noir\",  border:\"#1a1a1a\", text:\"#1a1a1a\", bg:\"rgba(26,26,26,0.08)\"},\n  {label:\"Or\",    border:\"#b8860b\", text:\"#b8860b\", bg:\"rgba(184,134,11,0.08)\"},\n];\nfunction hexToColor(hex) {\n  const r=parseInt(hex.slice(1,3),16), g=parseInt(hex.slice(3,5),16), b=parseInt(hex.slice(5,7),16);\n  return {label:\"Custom\", border:hex, text:hex, bg:`rgba(${r},${g},${b},0.08)`};\n}\n\n/* ───────────────────── Stamp SVG (unchanged geometry) ───────────────────── */\nfunction StampSVG({cfg, size=320}) {\n  const {shape,color,font,mainText,subText,dateText,tvaText,mainFs,subFs,dateFs,tvaFs} = cfg;\n  const cx=size/2, cy=size/2, r=size*.4;\n  const tc  = {fontFamily:font.value,fill:color.text,textAnchor:\"middle\"};\n  const ls  = {strokeDasharray:\"6 4\",strokeWidth:Math.max(1.5,size*.008)};\n  const sw  = Math.max(2,size*.009), gap=size*.04;\n\n  const mFs = mainFs  * size;\n  const sFs = subFs   * size;\n  const dFs = dateFs  * size;\n  const vFs = tvaFs   * size;\n\n  const mainLines = mainText ? mainText.split(\"\\n\") : [];\n  const subLines  = subText  ? subText.split(\"\\n\")  : [];\n  const hasDate = !!dateText, hasSub = subLines.length > 0, hasTva = !!tvaText;\n\n  const mainLineH = mFs * 1.28;\n  const subLineH  = sFs * 1.3;\n  const CAP = 0.72;\n\n  const mainBlockH = (mainLines.length - 1) * mainLineH + mFs * CAP;\n  const subBlockH  = hasSub ? (subLines.length - 1) * subLineH + sFs * CAP : 0;\n\n  const gDateLine = size * 0.013;\n  const gLineMain = size * 0.022;\n  const gMainSub  = size * 0.022;\n  const gSubTva   = size * 0.016;\n  const gMainTva  = size * 0.022;\n\n  let totalH = mainBlockH;\n  if (hasDate) totalH += dFs + gDateLine + gLineMain;\n  if (hasSub)  totalH += gMainSub + subBlockH;\n  if (hasTva)  totalH += (hasSub ? gSubTva : gMainTva) + vFs * CAP;\n\n  let curY = cy - totalH / 2;\n  let dateY, lineY, mainStartY, subStartY, tvaY;\n\n  if (hasDate) {\n    dateY = curY + dFs * CAP;\n    curY += dFs + gDateLine;\n    lineY = curY;\n    curY += gLineMain;\n  } else {\n    lineY = cy - mainBlockH / 2 - size * 0.04;\n  }\n\n  mainStartY = curY + mFs * CAP;\n  curY += mainBlockH + (mFs * (1 - CAP));\n\n  if (hasSub) {\n    curY += gMainSub;\n    subStartY = curY + sFs * CAP;\n    curY += subBlockH + sFs * (1 - CAP);\n  }\n\n  if (hasTva) {\n    curY += hasSub ? gSubTva : gMainTva;\n    tvaY = curY + vFs * CAP;\n  }\n\n  return (\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width={size} height={size}>\n      <g>\n        {shape===\"circle\"    && <><circle cx={cx} cy={cy} r={r} fill={color.bg} stroke={color.border} strokeWidth={sw}/><circle cx={cx} cy={cy} r={r-gap} fill=\"none\" stroke={color.border} {...ls}/></>}\n        {shape===\"rectangle\" && <><rect x={cx-r} y={cy-r*.7} width={r*2} height={r*1.4} rx={8} fill={color.bg} stroke={color.border} strokeWidth={sw}/><rect x={cx-r+gap} y={cy-r*.7+gap} width={(r-gap)*2} height={r*1.4-gap*2} rx={4} fill=\"none\" stroke={color.border} {...ls}/></>}\n        {shape===\"hexagon\"   && <><path d={hexPath(cx,cy,r)} fill={color.bg} stroke={color.border} strokeWidth={sw}/><path d={hexPath(cx,cy,r-gap)} fill=\"none\" stroke={color.border} {...ls}/></>}\n        {shape===\"diamond\"   && <><polygon points={`${cx},${cy-r} ${cx+r*.75},${cy} ${cx},${cy+r} ${cx-r*.75},${cy}`} fill={color.bg} stroke={color.border} strokeWidth={sw}/><polygon points={`${cx},${cy-r+gap} ${cx+(r-gap)*.75},${cy} ${cx},${cy+r-gap} ${cx-(r-gap)*.75},${cy}`} fill=\"none\" stroke={color.border} {...ls}/></>}\n        {hasDate && <text x={cx} y={dateY} fontSize={dFs} fontWeight=\"400\" letterSpacing={size*.004} style={tc}>{dateText}</text>}\n        <line x1={cx-size*.17} y1={lineY} x2={cx-size*.055} y2={lineY} stroke={color.border} strokeWidth={size*.005} opacity={0.7}/>\n        <line x1={cx+size*.055} y1={lineY} x2={cx+size*.17}  y2={lineY} stroke={color.border} strokeWidth={size*.005} opacity={0.7}/>\n        {mainLines.map((line,i)=>(\n          <text key={i} x={cx} y={mainStartY + i*mainLineH} fontSize={mFs} fontWeight=\"800\" letterSpacing={size*.01} style={tc}>{line}</text>\n        ))}\n        {hasSub && subLines.map((line,i)=>(\n          <text key={i} x={cx} y={subStartY + i*subLineH} fontSize={sFs} fontWeight=\"500\" letterSpacing={size*.004} style={tc}>{line}</text>\n        ))}\n        {hasTva && <text x={cx} y={tvaY} fontSize={vFs} fontWeight=\"400\" letterSpacing={size*.003} style={{...tc,fontStyle:\"italic\"}}>{tvaText}</text>}\n      </g>\n    </svg>\n  );\n}\n\n/* ───────────────────── Reusable UI atoms ───────────────────── */\n\nfunction SectionLabel({ children, right }) {\n  return (\n    <div style={{display:\"flex\",alignItems:\"center\",justifyContent:\"space-between\",marginBottom:10}}>\n      <span style={{fontSize:11,fontWeight:700,letterSpacing:.8,color:\"var(--ink-soft)\",textTransform:\"uppercase\"}}>{children}</span>\n      {right}\n    </div>\n  );\n}\n\nfunction FieldGroup({ label, hint, slider, children }) {\n  return (\n    <div style={{marginBottom:18}}>\n      <div style={{display:\"flex\",alignItems:\"baseline\",justifyContent:\"space-between\",marginBottom:8}}>\n        <label style={{fontSize:13,fontWeight:600,color:\"var(--ink)\"}}>{label}</label>\n        {hint && <span style={{fontSize:11,color:\"var(--ink-faint)\"}}>{hint}</span>}\n      </div>\n      {children}\n      {slider && <div style={{marginTop:10}}>{slider}</div>}\n    </div>\n  );\n}\n\nfunction SizeSlider({ value, onChange, min, max, step, accent }) {\n  return (\n    <div style={{display:\"flex\",alignItems:\"center\",gap:10}}>\n      <span style={{fontSize:10,fontWeight:700,color:\"var(--ink-faint)\"}}>A</span>\n      <input type=\"range\" min={min} max={max} step={step} value={value} onChange={onChange} style={{flex:1,accentColor:accent}}/>\n      <span style={{fontSize:14,fontWeight:700,color:\"var(--ink-faint)\"}}>A</span>\n    </div>\n  );\n}\n\nfunction TextInput(props) {\n  return <input {...props} style={{\n    width:\"100%\", padding:\"10px 12px\", borderRadius:10, border:\"1px solid var(--line-strong)\",\n    background:\"var(--surface-2)\", fontSize:14, color:\"var(--ink)\", transition:\"border-color .15s, box-shadow .15s\",\n    ...props.style\n  }} onFocus={e=>{ e.target.style.borderColor=\"var(--ink)\"; e.target.style.boxShadow=\"0 0 0 3px rgba(43,33,24,.08)\"; props.onFocus?.(e); }}\n     onBlur ={e=>{ e.target.style.borderColor=\"var(--line-strong)\"; e.target.style.boxShadow=\"none\"; props.onBlur?.(e); }}/>\n}\n\nfunction TextArea(props) {\n  return <textarea {...props} style={{\n    width:\"100%\", padding:\"10px 12px\", borderRadius:10, border:\"1px solid var(--line-strong)\",\n    background:\"var(--surface-2)\", fontSize:14, color:\"var(--ink)\", resize:\"vertical\", lineHeight:1.5,\n    transition:\"border-color .15s, box-shadow .15s\",\n    ...props.style\n  }} onFocus={e=>{ e.target.style.borderColor=\"var(--ink)\"; e.target.style.boxShadow=\"0 0 0 3px rgba(43,33,24,.08)\"; props.onFocus?.(e); }}\n     onBlur ={e=>{ e.target.style.borderColor=\"var(--line-strong)\"; e.target.style.boxShadow=\"none\"; props.onBlur?.(e); }}/>\n}\n\nfunction Chip({ active, color, children, onClick, style }) {\n  return (\n    <button onClick={onClick} style={{\n      padding:\"7px 11px\", borderRadius:8, fontSize:12, fontWeight:600, cursor:\"pointer\",\n      background: active ? color : \"var(--surface)\",\n      color: active ? \"#fff\" : \"var(--ink-soft)\",\n      border: `1px solid ${active ? color : \"var(--line-strong)\"}`,\n      transition:\"all .12s\",\n      ...style,\n    }}>{children}</button>\n  );\n}\n\nfunction PrimaryButton({ children, onClick, disabled, color, style }) {\n  return (\n    <button onClick={onClick} disabled={disabled} style={{\n      width:\"100%\", padding:\"13px 16px\", borderRadius:11, border:\"none\",\n      background: disabled ? \"#d4c8b0\" : (color || \"var(--ink)\"),\n      color:\"#fff\", fontWeight:700, fontSize:14, letterSpacing:.3,\n      cursor: disabled ? \"not-allowed\" : \"pointer\",\n      boxShadow: disabled ? \"none\" : \"0 6px 16px -6px rgba(43,33,24,.4)\",\n      transition:\"transform .1s, box-shadow .15s\",\n      ...style,\n    }}\n    onMouseDown={e=>{ if(!disabled) e.currentTarget.style.transform=\"translateY(1px)\"; }}\n    onMouseUp  ={e=>{ if(!disabled) e.currentTarget.style.transform=\"none\"; }}\n    onMouseLeave={e=>{ if(!disabled) e.currentTarget.style.transform=\"none\"; }}>\n      {children}\n    </button>\n  );\n}\n\nfunction SecondaryButton({ children, onClick, style }) {\n  return (\n    <button onClick={onClick} style={{\n      padding:\"10px 14px\", borderRadius:10, border:\"1px solid var(--line-strong)\",\n      background:\"var(--surface)\", color:\"var(--ink)\", fontWeight:600, fontSize:13,\n      cursor:\"pointer\", transition:\"all .12s\",\n      ...style,\n    }}\n    onMouseEnter={e=>{ e.currentTarget.style.background=\"var(--surface-2)\"; e.currentTarget.style.borderColor=\"var(--ink-soft)\"; }}\n    onMouseLeave={e=>{ e.currentTarget.style.background=\"var(--surface)\"; e.currentTarget.style.borderColor=\"var(--line-strong)\"; }}>\n      {children}\n    </button>\n  );\n}\n\n/* ───────────────────── App ───────────────────── */\nfunction App() {\n  /* stamp state */\n  const [shape, setShape] = useState(\"circle\");\n  const [ci, setCi] = useState(0);\n  const [customHex, setCustomHex] = useState('#e53e3e');\n  const [fi, setFi] = useState(0);\n  const [main, setMain] = useState(\"APPROUVÉ\");\n  const [sub, setSub] = useState(\"Direction Générale\");\n  const [date, setDate] = useState(new Date().toLocaleDateString(\"fr-FR\"));\n  const [tva, setTva] = useState(\"FR 12 345 678 901\");\n  const [mainFs, setMainFs] = useState(0.09);\n  const [subFs, setSubFs] = useState(0.037);\n  const [dateFs, setDateFs] = useState(0.04);\n  const [tvaFs, setTvaFs] = useState(0.034);\n  const [opa, setOpa] = useState(0.82);\n  const [rot, setRot] = useState(0);\n  const [autoDate, setAutoDate] = useState(false);\n\n  /* PDF state */\n  const [stampPt, setStampPt] = useState(120);\n  const [applyMode, setApplyMode] = useState(\"current\"); // current | all | range\n  const [rangeFrom, setRangeFrom] = useState(1);\n  const [rangeTo, setRangeTo] = useState(1);\n  const [pdfFile, setPdfFile] = useState(null);\n  const [libsOk, setLibsOk] = useState(false);\n  const [pageNum, setPageNum] = useState(1);\n  const [totalPg, setTotalPg] = useState(0);\n  const [cvSz, setCvSz] = useState({w:480,h:678});\n  const [pdfDims, setPdfDims] = useState({w:595,h:842});\n  const [pos, setPos] = useState({x:30,y:30});\n  const [drag, setDrag] = useState(false);\n  const [dOff, setDOff] = useState({x:0,y:0});\n  const [resizing, setResizing] = useState(false);\n  const [resStart, setResStart] = useState({mx:0,my:0,sz:120});\n  const [busy, setBusy] = useState(false);\n  const [msg, setMsg] = useState(\"\");\n\n  /* auto-date — refresh on toggle, and tick at midnight */\n  useEffect(()=>{\n    if (!autoDate) return;\n    const tick = () => setDate(new Date().toLocaleDateString(\"fr-FR\"));\n    tick();\n    const id = setInterval(tick, 60*1000);\n    return () => clearInterval(id);\n  },[autoDate]);\n\n  /* templates */\n  const [templates, setTemplates] = useState(()=>{ try{ return JSON.parse(localStorage.getItem('tampon_tpls')||'[]'); }catch{ return []; } });\n  const [tplName, setTplName] = useState(\"\");\n  const [showTplInput, setShowTplInput] = useState(false);\n  const [showTpls, setShowTpls] = useState(false);\n\n  const cvRef = useRef(null);\n  const contRef = useRef(null);\n  const jsDocRef = useRef(null);\n  const bytesRef = useRef(null);\n  const taskRef = useRef(null);\n\n  const color = ci < COLORS.length ? COLORS[ci] : hexToColor(customHex);\n  const font = FONTS[fi];\n  const cfg = {shape,color,font,mainText:main,subText:sub,dateText:date,tvaText:tva,mainFs,subFs,dateFs,tvaFs};\n  const dispSz = Math.max(40, Math.round((stampPt/pdfDims.w)*cvSz.w));\n\n  /* libs */\n  useEffect(()=>{\n    const workerSrc = (window.__resources && window.__resources.pdfWorker) || \"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js\";\n    let n=0; const ok=()=>{ if(++n>=2) setLibsOk(true); };\n    if(window.pdfjsLib){ window.pdfjsLib.GlobalWorkerOptions.workerSrc=workerSrc; ok(); }\n    else {\n      const s=document.createElement(\"script\"); s.src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js\";\n      s.onload=()=>{ window.pdfjsLib.GlobalWorkerOptions.workerSrc=workerSrc; ok(); }; document.head.appendChild(s);\n    }\n    if(window.PDFLib) ok();\n    else { const s=document.createElement(\"script\"); s.src=\"https://cdnjs.cloudflare.com/ajax/libs/pdf-lib/1.17.1/pdf-lib.min.js\"; s.onload=ok; document.head.appendChild(s); }\n  },[]);\n\n  /* render page */\n  const renderPage = useCallback(async(num)=>{\n    if(!jsDocRef.current||!cvRef.current) return;\n    if(taskRef.current){ taskRef.current.cancel(); taskRef.current=null; }\n    const page = await jsDocRef.current.getPage(num);\n    const W=520, scale=W/page.view[2];\n    const vp = page.getViewport({scale});\n    cvRef.current.width=vp.width; cvRef.current.height=vp.height;\n    setCvSz({w:vp.width,h:vp.height});\n    setPdfDims({w:page.view[2],h:page.view[3]});\n    const t = page.render({canvasContext:cvRef.current.getContext(\"2d\"),viewport:vp});\n    taskRef.current=t;\n    try{ await t.promise; }catch(e){ if(e.name!==\"RenderingCancelledException\") console.error(e); }\n  },[]);\n\n  useEffect(()=>{\n    if(!pdfFile||!libsOk) return;\n    (async()=>{\n      const ab = await pdfFile.arrayBuffer();\n      bytesRef.current = new Uint8Array(ab);\n      const doc = await window.pdfjsLib.getDocument({data:bytesRef.current.slice(0)}).promise;\n      jsDocRef.current=doc; setTotalPg(doc.numPages); setPageNum(1); setPos({x:40,y:40});\n      setRangeFrom(1); setRangeTo(doc.numPages);\n      await renderPage(1);\n    })();\n  },[pdfFile,libsOk,renderPage]);\n\n  useEffect(()=>{ if(jsDocRef.current) renderPage(pageNum); },[pageNum,renderPage]);\n\n  /* drag */\n  const clamp = useCallback((x,y)=>({\n    x:Math.max(0,Math.min(x,cvSz.w-dispSz)),\n    y:Math.max(0,Math.min(y,cvSz.h-dispSz)),\n  }),[cvSz,dispSz]);\n\n  const startDrag = useCallback((cx,cy,rect)=>{ setDOff({x:cx-rect.left,y:cy-rect.top}); setDrag(true); },[]);\n  const moveDrag  = useCallback((cx,cy)=>{\n    if(!drag||!contRef.current) return;\n    const r=contRef.current.getBoundingClientRect();\n    setPos(clamp(cx-r.left-dOff.x, cy-r.top-dOff.y));\n  },[drag,dOff,clamp]);\n\n  const startResize = useCallback((e, cx, cy)=>{\n    e.stopPropagation(); e.preventDefault();\n    setResStart({mx:cx, my:cy, sz:stampPt});\n    setResizing(true);\n  },[stampPt]);\n\n  const moveResize = useCallback((cx,cy)=>{\n    if(!resizing) return;\n    const delta = ((cx - resStart.mx) + (cy - resStart.my)) / 2;\n    const newDisp = Math.max(40, (resStart.sz / pdfDims.w * cvSz.w) + delta);\n    const newPt = Math.round(Math.max(30, Math.min(300, newDisp / cvSz.w * pdfDims.w)));\n    setStampPt(newPt);\n  },[resizing, resStart, pdfDims, cvSz]);\n\n  const onMM = useCallback((e)=>{ moveDrag(e.clientX,e.clientY); moveResize(e.clientX,e.clientY); },[moveDrag,moveResize]);\n  const onMU = useCallback(()=>{ setDrag(false); setResizing(false); },[]);\n\n  const onMD = useCallback((e)=>{ e.preventDefault(); startDrag(e.clientX,e.clientY,e.currentTarget.getBoundingClientRect()); },[startDrag]);\n  const onTS = useCallback((e)=>{ const t=e.touches[0]; startDrag(t.clientX,t.clientY,e.currentTarget.getBoundingClientRect()); },[startDrag]);\n  const onTM = useCallback((e)=>{ e.preventDefault(); const t=e.touches[0]; moveDrag(t.clientX,t.clientY); moveResize(t.clientX,t.clientY); },[moveDrag,moveResize]);\n\n  /* templates */\n  function saveTemplate() {\n    const name = tplName.trim() || \"Template \" + (templates.length + 1);\n    const tpl = { id:Date.now(), name, shape, ci, fi, main, sub, date, tva, mainFs, subFs, dateFs, tvaFs, opa, rot, customHex };\n    const updated = [...templates, tpl];\n    setTemplates(updated);\n    localStorage.setItem('tampon_tpls', JSON.stringify(updated));\n    setTplName(\"\"); setShowTplInput(false);\n  }\n  function loadTemplate(tpl) {\n    setShape(tpl.shape); setCi(tpl.ci); setFi(tpl.fi);\n    setMain(tpl.main); setSub(tpl.sub); setDate(tpl.date); setTva(tpl.tva);\n    setMainFs(tpl.mainFs); setSubFs(tpl.subFs); setDateFs(tpl.dateFs); setTvaFs(tpl.tvaFs);\n    setOpa(tpl.opa);\n    if (typeof tpl.rot === \"number\") setRot(tpl.rot);\n    if (tpl.customHex) setCustomHex(tpl.customHex);\n    setShowTpls(false);\n  }\n  function deleteTemplate(id) {\n    const updated = templates.filter(t=>t.id!==id);\n    setTemplates(updated);\n    localStorage.setItem('tampon_tpls', JSON.stringify(updated));\n  }\n\n  async function exportSVG() {\n    const svg = document.getElementById(\"stamp-hidden\").querySelector(\"svg\").cloneNode(true);\n    const css = await getEmbeddedFontCSS();\n    if (css) {\n      const styleEl = document.createElementNS(\"http://www.w3.org/2000/svg\", \"style\");\n      styleEl.textContent = css;\n      svg.insertBefore(styleEl, svg.firstChild);\n    }\n    const a = document.createElement(\"a\");\n    a.href = URL.createObjectURL(new Blob([new XMLSerializer().serializeToString(svg)], {type:\"image/svg+xml\"}));\n    a.download = \"tampon.svg\"; a.click();\n  }\n\n  async function exportPNG() {\n    const svg = document.getElementById(\"stamp-hidden\").querySelector(\"svg\");\n    const png = await svgToPngBytes(svg, 1200);\n    const a = document.createElement(\"a\");\n    a.href = URL.createObjectURL(new Blob([png],{type:\"image/png\"}));\n    a.download = \"tampon.png\"; a.click();\n  }\n\n  // Which page indices (0-based) the stamp should be applied to\n  const targetPages = useMemo(() => {\n    if (applyMode === \"all\") return Array.from({length:totalPg}, (_,i)=>i);\n    if (applyMode === \"range\") {\n      const from = Math.max(1, Math.min(totalPg, rangeFrom));\n      const to   = Math.max(from, Math.min(totalPg, rangeTo));\n      const arr = []; for (let i=from; i<=to; i++) arr.push(i-1); return arr;\n    }\n    return [pageNum-1];\n  }, [applyMode, totalPg, rangeFrom, rangeTo, pageNum]);\n\n  async function applyStamp() {\n    if(!bytesRef.current||!libsOk) return;\n    setBusy(true);\n    const n = targetPages.length;\n    setMsg(`Application sur ${n} page${n>1?\"s\":\"\"}…`);\n    try {\n      const {PDFDocument, degrees}=window.PDFLib;\n      const svgEl=document.getElementById(\"stamp-hidden\").querySelector(\"svg\");\n      const png=await svgToPngBytes(svgEl,600);\n      const doc=await PDFDocument.load(bytesRef.current.slice(0));\n      const img=await doc.embedPng(png);\n      const pages = doc.getPages();\n      const a = (rot * Math.PI) / 180;\n      const cos = Math.cos(a), sin = Math.sin(a);\n\n      for (const idx of targetPages) {\n        const page = pages[idx];\n        const {width:pw, height:ph} = page.getSize();\n        const pdfX = (pos.x/cvSz.w)*pw;\n        const pdfY = ph - ((pos.y/cvSz.h)*ph) - stampPt;\n        // PDF-lib rotates the image around its bottom-left; offset so it rotates around its center.\n        const cx = pdfX + stampPt/2, cy = pdfY + stampPt/2;\n        const xNew = cx - (stampPt/2)*cos + (stampPt/2)*sin;\n        const yNew = cy - (stampPt/2)*sin - (stampPt/2)*cos;\n        page.drawImage(img, {\n          x: xNew, y: yNew,\n          width: stampPt, height: stampPt,\n          opacity: opa,\n          rotate: degrees(rot),\n        });\n      }\n\n      const out=await doc.save();\n      const link=document.createElement(\"a\"); link.href=URL.createObjectURL(new Blob([out],{type:\"application/pdf\"}));\n      link.download=pdfFile.name.replace(/\\.pdf$/i,\"_tamponné.pdf\"); link.click();\n      setMsg(`PDF téléchargé — ${n} page${n>1?\"s\":\"\"} tamponnée${n>1?\"s\":\"\"}`);\n    } catch(e){ setMsg(\"Erreur : \"+e.message); }\n    setBusy(false);\n  }\n\n  /* arrow-key nudging (only when PDF loaded) */\n  useEffect(() => {\n    if (!pdfFile) return;\n    const onKey = (e) => {\n      const tag = (e.target.tagName || \"\").toLowerCase();\n      if (tag === \"input\" || tag === \"textarea\") return;\n      const step = e.shiftKey ? 10 : 1;\n      let nx = pos.x, ny = pos.y, used = false;\n      if (e.key === \"ArrowLeft\")  { nx -= step; used = true; }\n      if (e.key === \"ArrowRight\") { nx += step; used = true; }\n      if (e.key === \"ArrowUp\")    { ny -= step; used = true; }\n      if (e.key === \"ArrowDown\")  { ny += step; used = true; }\n      if (used) {\n        e.preventDefault();\n        setPos(clamp(nx, ny));\n      }\n    };\n    window.addEventListener(\"keydown\", onKey);\n    return () => window.removeEventListener(\"keydown\", onKey);\n  }, [pdfFile, pos, clamp]);\n\n  function handleFile(f) {\n    if (f && f.type === \"application/pdf\") {\n      setPdfFile(f); setMsg(\"\");\n    }\n  }\n\n  /* ───────────────────── Render ───────────────────── */\n  return (\n    <div style={{minHeight:\"100vh\",background:\"var(--bg)\",padding:\"28px 28px 60px\"}}\n         onMouseMove={onMM} onMouseUp={onMU}>\n\n      {/* hidden export stamp */}\n      <div id=\"stamp-hidden\" style={{position:\"absolute\",left:-9999,top:-9999}}><StampSVG cfg={cfg} size={600}/></div>\n\n      {/* Header */}\n      <header style={{maxWidth:1320,margin:\"0 auto 28px\",display:\"flex\",alignItems:\"center\",justifyContent:\"space-between\",gap:24,flexWrap:\"wrap\"}}>\n        <div style={{display:\"flex\",alignItems:\"center\",gap:14}}>\n          <svg width=\"44\" height=\"44\" viewBox=\"0 0 40 40\" style={{flexShrink:0}}>\n            <defs>\n              <radialGradient id=\"logoBg\" cx=\"38%\" cy=\"34%\" r=\"68%\">\n                <stop offset=\"0%\" stopColor=\"#3d2f23\"/>\n                <stop offset=\"100%\" stopColor=\"#2b2118\"/>\n              </radialGradient>\n            </defs>\n            <circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"url(#logoBg)\"/>\n            <circle cx=\"20\" cy=\"20\" r=\"13.5\" fill=\"none\" stroke=\"#f6f2ea\" strokeOpacity=\"0.85\" strokeWidth=\"0.9\" strokeDasharray=\"2 1.4\"/>\n            <line x1=\"9\" y1=\"20\" x2=\"12.4\" y2=\"20\" stroke=\"#f6f2ea\" strokeOpacity=\"0.85\" strokeWidth=\"0.9\" strokeLinecap=\"round\"/>\n            <line x1=\"27.6\" y1=\"20\" x2=\"31\" y2=\"20\" stroke=\"#f6f2ea\" strokeOpacity=\"0.85\" strokeWidth=\"0.9\" strokeLinecap=\"round\"/>\n            <text x=\"20\" y=\"26.2\" fontFamily=\"'Instrument Serif', Georgia, serif\" fontStyle=\"italic\" fontSize=\"18\" fill=\"#f6f2ea\" textAnchor=\"middle\">T</text>\n          </svg>\n          <div>\n            <h1 style={{fontSize:22,fontWeight:400,color:\"var(--ink)\",letterSpacing:-.3,fontFamily:\"'Instrument Serif', serif\",lineHeight:1}}>Tampon Numérique</h1>\n            <p style={{fontSize:12,color:\"var(--ink-soft)\",marginTop:3}}>Créez, personnalisez et apposez votre tampon sur un PDF</p>\n          </div>\n        </div>\n        <div style={{display:\"flex\",gap:8,alignItems:\"center\"}}>\n          <SecondaryButton onClick={()=>setShowTpls(true)} style={{display:\"flex\",alignItems:\"center\",gap:6}}>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><path d=\"M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z\"/></svg>\n            Mes tampons {templates.length > 0 && <span style={{background:\"var(--ink)\",color:\"#fff\",borderRadius:999,padding:\"1px 7px\",fontSize:11,fontWeight:700}}>{templates.length}</span>}\n          </SecondaryButton>\n          <SecondaryButton onClick={exportSVG} style={{display:\"flex\",alignItems:\"center\",gap:6}}>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"/></svg>\n            SVG\n          </SecondaryButton>\n          <SecondaryButton onClick={exportPNG} style={{display:\"flex\",alignItems:\"center\",gap:6}}>\n            <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><polyline points=\"7 10 12 15 17 10\"/><line x1=\"12\" y1=\"15\" x2=\"12\" y2=\"3\"/></svg>\n            PNG\n          </SecondaryButton>\n        </div>\n      </header>\n\n      {/* Main 3-column layout */}\n      <div style={{maxWidth:1320,margin:\"0 auto\",display:\"grid\",gridTemplateColumns:\"360px 340px 1fr\",gap:20,alignItems:\"start\"}}>\n\n        {/* ━━━━━━━ LEFT: editor controls ━━━━━━━ */}\n        <section style={{background:\"var(--surface)\",borderRadius:\"var(--radius)\",padding:24,boxShadow:\"var(--shadow)\",border:\"1px solid var(--line)\"}}>\n          <SectionLabel>Contenu</SectionLabel>\n\n          <FieldGroup\n            label=\"Texte principal\"\n            hint=\"Entrée = nouvelle ligne\"\n            slider={<SizeSlider value={mainFs} min={0.04} max={0.18} step={0.005}\n                                accent={color.border}\n                                onChange={e=>setMainFs(parseFloat(e.target.value))}/>}\n          >\n            <div style={{display:\"flex\",gap:5,flexWrap:\"wrap\",marginBottom:10}}>\n              {STATUSES.map(s=>(\n                <Chip key={s} active={main===s} color={color.border} onClick={()=>setMain(s)} style={{padding:\"5px 9px\",fontSize:11}}>{s}</Chip>\n              ))}\n            </div>\n            <TextArea value={main} onChange={e=>setMain(e.target.value.toUpperCase())} placeholder={\"Ex: APPROUVÉ\\nAL CONSULTING\"} rows={2} maxLength={60} style={{textTransform:\"uppercase\",fontWeight:600}}/>\n          </FieldGroup>\n\n          <FieldGroup label=\"Date\" hint={autoDate ? \"⚡ mise à jour automatique\" : null}>\n            <div style={{display:\"flex\",gap:8,alignItems:\"stretch\"}}>\n              <TextInput value={date} onChange={e=>setDate(e.target.value)} placeholder=\"ex: 27/05/2026\" maxLength={20} disabled={autoDate} style={{flex:1,opacity:autoDate?0.6:1,cursor:autoDate?\"not-allowed\":\"text\"}}/>\n              <button onClick={()=>setAutoDate(v=>!v)} title=\"Date du jour, mise à jour automatique\" style={{\n                padding:\"0 12px\", borderRadius:10, fontSize:11, fontWeight:700, cursor:\"pointer\",\n                background: autoDate ? \"var(--ink)\" : \"var(--surface-2)\",\n                color: autoDate ? \"#fff\" : \"var(--ink-soft)\",\n                border: `1px solid ${autoDate ? \"var(--ink)\" : \"var(--line-strong)\"}`,\n                display:\"flex\",alignItems:\"center\",gap:5,whiteSpace:\"nowrap\",\n              }}>\n                <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2.2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><polyline points=\"12 7 12 12 15 14\"/></svg>\n                Auto\n              </button>\n            </div>\n            <div style={{marginTop:10}}><SizeSlider value={dateFs} min={0.025} max={0.07} step={0.003} accent={color.border} onChange={e=>setDateFs(parseFloat(e.target.value))}/></div>\n          </FieldGroup>\n\n          <FieldGroup\n            label=\"Adresse\"\n            hint=\"Entrée = nouvelle ligne\"\n            slider={<SizeSlider value={subFs} min={0.02} max={0.07} step={0.003}\n                                accent={color.border}\n                                onChange={e=>setSubFs(parseFloat(e.target.value))}/>}\n          >\n            <TextArea value={sub} onChange={e=>setSub(e.target.value)} placeholder={\"12 rue des Lilas\\n75000 Paris\"} rows={2} maxLength={80}/>\n          </FieldGroup>\n\n          <FieldGroup\n            label=\"N° TVA intracommunautaire\"\n            slider={<SizeSlider value={tvaFs} min={0.02} max={0.06} step={0.002}\n                                accent={color.border}\n                                onChange={e=>setTvaFs(parseFloat(e.target.value))}/>}\n          >\n            <TextInput value={tva} onChange={e=>setTva(e.target.value)} placeholder=\"FR 12 345 678 901\" maxLength={25}/>\n          </FieldGroup>\n\n          <div style={{height:1,background:\"var(--line)\",margin:\"4px 0 22px\"}}/>\n\n          <SectionLabel>Style</SectionLabel>\n\n          <FieldGroup label=\"Forme\">\n            <div style={{display:\"grid\",gridTemplateColumns:\"1fr 1fr 1fr 1fr\",gap:6}}>\n              {SHAPES.map(s=>(\n                <button key={s.id} onClick={()=>setShape(s.id)} title={s.label} style={{\n                  padding:\"10px 4px\",borderRadius:10,cursor:\"pointer\",\n                  background: shape===s.id ? \"var(--ink)\" : \"var(--surface-2)\",\n                  border: `1px solid ${shape===s.id ? \"var(--ink)\" : \"var(--line-strong)\"}`,\n                  color: shape===s.id ? \"#fff\" : \"var(--ink-soft)\",\n                  display:\"flex\",flexDirection:\"column\",alignItems:\"center\",gap:6,\n                  transition:\"all .12s\",\n                }}>\n                  <svg width=\"22\" height=\"22\" viewBox=\"0 0 22 22\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"1.8\">\n                    {s.id===\"circle\" && <circle cx=\"11\" cy=\"11\" r=\"8\"/>}\n                    {s.id===\"rectangle\" && <rect x=\"3\" y=\"6\" width=\"16\" height=\"10\" rx=\"1.5\"/>}\n                    {s.id===\"hexagon\" && <polygon points=\"11,3 18,7 18,15 11,19 4,15 4,7\"/>}\n                    {s.id===\"diamond\" && <polygon points=\"11,3 19,11 11,19 3,11\"/>}\n                  </svg>\n                  <span style={{fontSize:10,fontWeight:600}}>{s.label}</span>\n                </button>\n              ))}\n            </div>\n          </FieldGroup>\n\n          <FieldGroup label=\"Couleur\">\n            <div style={{display:\"flex\",gap:10,flexWrap:\"wrap\"}}>\n              {COLORS.map((c,i)=>(\n                <button key={c.label} onClick={()=>setCi(i)} title={c.label} style={{\n                  width:32, height:32, borderRadius:\"50%\", background:c.border,\n                  border: ci===i ? \"2px solid var(--ink)\" : \"2px solid transparent\",\n                  boxShadow: ci===i ? `0 0 0 2px #fff inset` : \"0 0 0 1px rgba(0,0,0,.08) inset\",\n                  cursor:\"pointer\", transition:\"transform .1s\",\n                }}\n                onMouseEnter={e=>e.currentTarget.style.transform=\"scale(1.08)\"}\n                onMouseLeave={e=>e.currentTarget.style.transform=\"none\"}\n                />\n              ))}\n              <label title=\"Couleur personnalisée\" style={{\n                width:32, height:32, borderRadius:\"50%\", background:customHex,\n                border: ci===6 ? \"2px solid var(--ink)\" : \"2px solid transparent\",\n                boxShadow: ci===6 ? \"0 0 0 2px #fff inset\" : \"0 0 0 1px rgba(0,0,0,.08) inset\",\n                cursor:\"pointer\", display:\"inline-flex\", alignItems:\"center\",\n                justifyContent:\"center\", overflow:\"hidden\", position:\"relative\",\n                flexShrink:0,\n              }}>\n                <input type=\"color\" value={customHex}\n                  onChange={e=>{setCustomHex(e.target.value); setCi(6);}}\n                  style={{opacity:0, position:\"absolute\", inset:0, width:\"100%\", height:\"100%\", cursor:\"pointer\"}} />\n              </label>\n            </div>\n          </FieldGroup>\n\n          <FieldGroup label=\"Police\">\n            <div style={{display:\"grid\",gridTemplateColumns:\"1fr 1fr 1fr\",gap:6}}>\n              {FONTS.map((f,i)=>(\n                <button key={f.label} onClick={()=>setFi(i)} title={f.hint || f.label} style={{\n                  padding:\"12px 4px 8px\",borderRadius:10,cursor:\"pointer\",\n                  background: fi===i ? \"var(--ink)\" : \"var(--surface-2)\",\n                  border: `1px solid ${fi===i ? \"var(--ink)\" : \"var(--line-strong)\"}`,\n                  color: fi===i ? \"#fff\" : \"var(--ink)\",\n                  display:\"flex\",flexDirection:\"column\",alignItems:\"center\",gap:3,\n                  transition:\"all .12s\",\n                }}>\n                  <span style={{fontFamily:f.value, fontSize:18, fontWeight:fi===i?700:600, lineHeight:1}}>Ag</span>\n                  <span style={{fontSize:10,fontWeight:600,opacity:.75,letterSpacing:.2}}>{f.label}</span>\n                </button>\n              ))}\n            </div>\n          </FieldGroup>\n\n          <FieldGroup label={`Opacité — ${Math.round(opa*100)}%`}>\n            <input type=\"range\" min={0.3} max={1} step={0.05} value={opa}\n                   onChange={e=>setOpa(parseFloat(e.target.value))}\n                   style={{width:\"100%\",accentColor:color.border}}/>\n          </FieldGroup>\n\n          <FieldGroup label={`Inclinaison — ${rot > 0 ? \"+\" : \"\"}${rot}°`} hint={rot===0 ? null : <button onClick={()=>setRot(0)} style={{background:\"none\",border:\"none\",color:\"var(--ink-soft)\",fontSize:11,cursor:\"pointer\",textDecoration:\"underline\"}}>Réinitialiser</button>}>\n            <div style={{display:\"flex\",alignItems:\"center\",gap:8}}>\n              <input type=\"range\" min={-30} max={30} step={1} value={rot}\n                     onChange={e=>setRot(parseInt(e.target.value))}\n                     style={{flex:1,accentColor:color.border}}/>\n            </div>\n            <div style={{display:\"flex\",gap:6,marginTop:8}}>\n              {[-7, -3, 0, 3, 7].map(deg => (\n                <button key={deg} onClick={()=>setRot(deg)} style={{\n                  flex:1, padding:\"5px 0\", borderRadius:7, fontSize:11, fontWeight:600, cursor:\"pointer\",\n                  background: rot===deg ? \"var(--ink)\" : \"var(--surface-2)\",\n                  color: rot===deg ? \"#fff\" : \"var(--ink-soft)\",\n                  border: `1px solid ${rot===deg ? \"var(--ink)\" : \"var(--line-strong)\"}`,\n                }}>{deg > 0 ? \"+\" : \"\"}{deg}°</button>\n              ))}\n            </div>\n          </FieldGroup>\n        </section>\n\n        {/* ━━━━━━━ CENTER: live preview ━━━━━━━ */}\n        <section style={{position:\"sticky\",top:20,display:\"flex\",flexDirection:\"column\",gap:14}}>\n          <div style={{\n            background:\"var(--surface)\",borderRadius:\"var(--radius)\",padding:32,\n            boxShadow:\"var(--shadow-lift)\",border:\"1px solid var(--line)\",\n            display:\"flex\",flexDirection:\"column\",alignItems:\"center\",gap:18\n          }}>\n            <div style={{fontSize:11,fontWeight:700,letterSpacing:1.2,color:\"var(--ink-faint)\",textTransform:\"uppercase\"}}>Aperçu en direct</div>\n            <div style={{position:\"relative\",padding:18,background:\"var(--surface-2)\",borderRadius:14,border:\"1px dashed var(--line-strong)\"}}>\n              <div style={{transform:`rotate(${rot}deg)`,transition:\"transform .2s\"}}>\n                <StampSVG cfg={cfg} size={260}/>\n              </div>\n            </div>\n            <div style={{display:\"flex\",gap:8,width:\"100%\"}}>\n              {!showTplInput ? (\n                <SecondaryButton onClick={()=>setShowTplInput(true)} style={{flex:1,display:\"flex\",alignItems:\"center\",justifyContent:\"center\",gap:6}}>\n                  <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\"/><polyline points=\"17 21 17 13 7 13 7 21\"/><polyline points=\"7 3 7 8 15 8\"/></svg>\n                  Enregistrer comme template\n                </SecondaryButton>\n              ) : (\n                <div style={{display:\"flex\",gap:6,width:\"100%\"}} className=\"fade-in\">\n                  <TextInput autoFocus value={tplName} onChange={e=>setTplName(e.target.value)}\n                             onKeyDown={e=>{ if(e.key===\"Enter\") saveTemplate(); if(e.key===\"Escape\") setShowTplInput(false); }}\n                             placeholder=\"Nom du template…\"\n                             style={{flex:1,padding:\"8px 10px\",fontSize:13}}/>\n                  <button onClick={saveTemplate} style={{padding:\"0 14px\",borderRadius:10,border:\"none\",background:\"var(--ink)\",color:\"#fff\",fontWeight:700,fontSize:13,cursor:\"pointer\"}}>Enregistrer</button>\n                  <button onClick={()=>{setShowTplInput(false); setTplName(\"\");}} style={{padding:\"0 10px\",borderRadius:10,border:\"1px solid var(--line-strong)\",background:\"#fff\",color:\"var(--ink-soft)\",cursor:\"pointer\"}}>×</button>\n                </div>\n              )}\n            </div>\n          </div>\n\n          <div style={{padding:\"14px 16px\",background:\"var(--surface)\",borderRadius:\"var(--radius-sm)\",border:\"1px solid var(--line)\",fontSize:12,color:\"var(--ink-soft)\",lineHeight:1.6}}>\n            <strong style={{color:\"var(--ink)\"}}>Astuce Word</strong> — exportez en SVG, puis dans Word&nbsp;: <em>Insertion → Images</em> → sélectionnez le fichier.\n          </div>\n        </section>\n\n        {/* ━━━━━━━ RIGHT: PDF workspace ━━━━━━━ */}\n        <section style={{background:\"var(--surface)\",borderRadius:\"var(--radius)\",padding:24,boxShadow:\"var(--shadow)\",border:\"1px solid var(--line)\",minHeight:600}}>\n          {!pdfFile ? (\n            // Empty state — friendly dropzone\n            <div style={{display:\"flex\",flexDirection:\"column\",alignItems:\"center\",justifyContent:\"center\",minHeight:560,padding:24}}>\n              <div\n                onClick={()=>{const i=document.createElement(\"input\");i.type=\"file\";i.accept=\"application/pdf\";i.onchange=e=>handleFile(e.target.files[0]);i.click();}}\n                onDrop={e=>{e.preventDefault();handleFile(e.dataTransfer.files[0]);}}\n                onDragOver={e=>e.preventDefault()}\n                style={{\n                  width:\"100%\",maxWidth:480,padding:\"60px 40px\",borderRadius:18,\n                  border:\"2px dashed var(--line-strong)\",background:\"var(--surface-2)\",\n                  textAlign:\"center\",cursor:\"pointer\",transition:\"all .2s\",\n                }}\n                onMouseEnter={e=>{ e.currentTarget.style.borderColor=color.border; e.currentTarget.style.background=\"#fff\"; }}\n                onMouseLeave={e=>{ e.currentTarget.style.borderColor=\"var(--line-strong)\"; e.currentTarget.style.background=\"var(--surface-2)\"; }}\n              >\n                <div style={{width:72,height:72,margin:\"0 auto 18px\",position:\"relative\"}}>\n                  <svg width=\"72\" height=\"72\" viewBox=\"0 0 40 40\">\n                    <circle cx=\"20\" cy=\"20\" r=\"18\" fill=\"var(--ink)\"/>\n                    <circle cx=\"20\" cy=\"20\" r=\"13.5\" fill=\"none\" stroke=\"#f6f2ea\" strokeOpacity=\"0.7\" strokeWidth=\"0.8\" strokeDasharray=\"2 1.4\"/>\n                    <g stroke=\"#f6f2ea\" strokeWidth=\"1.6\" strokeLinecap=\"round\" strokeLinejoin=\"round\" fill=\"none\">\n                      <path d=\"M15 22 v-5 h10 v5\"/>\n                      <path d=\"M20 17 v-7\"/>\n                      <path d=\"M16.5 13.5 L20 10 L23.5 13.5\"/>\n                    </g>\n                  </svg>\n                </div>\n                <div style={{fontSize:18,fontWeight:700,color:\"var(--ink)\",marginBottom:6,fontFamily:\"'Instrument Serif', serif\"}}>Glissez votre PDF ici</div>\n                <div style={{fontSize:13,color:\"var(--ink-soft)\",marginBottom:18}}>ou cliquez pour parcourir vos fichiers</div>\n                <div style={{display:\"inline-block\",padding:\"8px 14px\",borderRadius:8,background:\"var(--ink)\",color:\"#fff\",fontSize:13,fontWeight:600}}>Choisir un fichier</div>\n                {!libsOk && <div style={{marginTop:18,fontSize:11,color:\"var(--ink-faint)\"}}>Chargement des librairies PDF…</div>}\n              </div>\n\n              <div style={{marginTop:32,display:\"grid\",gridTemplateColumns:\"repeat(3, 1fr)\",gap:14,maxWidth:480,width:\"100%\"}}>\n                {[\n                  [\"1\",\"Glissez votre PDF\",\"ou cliquez pour le sélectionner\"],\n                  [\"2\",\"Placez le tampon\",\"glissez-le à l'endroit voulu\"],\n                  [\"3\",\"Téléchargez\",\"votre PDF tamponné en un clic\"],\n                ].map(([n,t,d])=>(\n                  <div key={n} style={{padding:12,background:\"var(--surface-2)\",borderRadius:10,border:\"1px solid var(--line)\"}}>\n                    <div style={{width:22,height:22,borderRadius:\"50%\",background:\"var(--ink)\",color:\"#fff\",display:\"flex\",alignItems:\"center\",justifyContent:\"center\",fontSize:11,fontWeight:700,marginBottom:8}}>{n}</div>\n                    <div style={{fontSize:12,fontWeight:700,color:\"var(--ink)\",marginBottom:2}}>{t}</div>\n                    <div style={{fontSize:11,color:\"var(--ink-soft)\",lineHeight:1.4}}>{d}</div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          ) : (\n            // Loaded state — PDF with stamp\n            <div className=\"fade-in\">\n              {/* File toolbar */}\n              <div style={{display:\"flex\",alignItems:\"center\",justifyContent:\"space-between\",gap:12,marginBottom:18,paddingBottom:14,borderBottom:\"1px solid var(--line)\"}}>\n                <div style={{display:\"flex\",alignItems:\"center\",gap:10,minWidth:0,flex:1}}>\n                  <div style={{width:36,height:36,borderRadius:9,background:\"var(--surface-2)\",border:\"1px solid var(--line-strong)\",display:\"flex\",alignItems:\"center\",justifyContent:\"center\",flexShrink:0}}>\n                    <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/></svg>\n                  </div>\n                  <div style={{minWidth:0,flex:1}}>\n                    <div style={{fontSize:13,fontWeight:700,color:\"var(--ink)\",overflow:\"hidden\",textOverflow:\"ellipsis\",whiteSpace:\"nowrap\"}}>{pdfFile.name}</div>\n                    <div style={{fontSize:11,color:\"var(--ink-soft)\"}}>{totalPg} page{totalPg>1?\"s\":\"\"}</div>\n                  </div>\n                </div>\n                <SecondaryButton onClick={()=>{ setPdfFile(null); jsDocRef.current=null; bytesRef.current=null; setMsg(\"\"); }} style={{padding:\"7px 11px\",fontSize:12}}>\n                  Changer\n                </SecondaryButton>\n              </div>\n\n              {/* Controls row */}\n              <div style={{display:\"grid\",gridTemplateColumns:\"auto 1fr 1fr\",gap:18,marginBottom:18,alignItems:\"center\"}}>\n                {/* Page nav */}\n                {totalPg > 1 ? (\n                  <div style={{display:\"flex\",alignItems:\"center\",gap:4,background:\"var(--surface-2)\",borderRadius:9,border:\"1px solid var(--line-strong)\",padding:3}}>\n                    <button onClick={()=>setPageNum(p=>Math.max(1,p-1))} disabled={pageNum<=1} style={{padding:\"6px 10px\",border:\"none\",background:\"transparent\",cursor:pageNum<=1?\"not-allowed\":\"pointer\",opacity:pageNum<=1?.3:1,fontSize:14,color:\"var(--ink)\"}}>‹</button>\n                    <span style={{padding:\"0 8px\",fontSize:12,fontWeight:600,color:\"var(--ink)\",minWidth:60,textAlign:\"center\"}}>Page {pageNum} / {totalPg}</span>\n                    <button onClick={()=>setPageNum(p=>Math.min(totalPg,p+1))} disabled={pageNum>=totalPg} style={{padding:\"6px 10px\",border:\"none\",background:\"transparent\",cursor:pageNum>=totalPg?\"not-allowed\":\"pointer\",opacity:pageNum>=totalPg?.3:1,fontSize:14,color:\"var(--ink)\"}}>›</button>\n                  </div>\n                ) : <div style={{fontSize:12,color:\"var(--ink-faint)\",padding:\"6px 10px\"}}>Page unique</div>}\n\n                {/* Size */}\n                <div>\n                  <div style={{display:\"flex\",justifyContent:\"space-between\",marginBottom:5}}>\n                    <span style={{fontSize:11,fontWeight:600,color:\"var(--ink-soft)\"}}>Taille du tampon</span>\n                    <span style={{fontSize:11,fontWeight:700,color:\"var(--ink)\"}}>{stampPt}pt</span>\n                  </div>\n                  <input type=\"range\" min={30} max={300} step={5} value={stampPt} onChange={e=>setStampPt(parseInt(e.target.value))} style={{width:\"100%\",accentColor:color.border}}/>\n                </div>\n\n                {/* Opacity */}\n                <div>\n                  <div style={{display:\"flex\",justifyContent:\"space-between\",marginBottom:5}}>\n                    <span style={{fontSize:11,fontWeight:600,color:\"var(--ink-soft)\"}}>Opacité</span>\n                    <span style={{fontSize:11,fontWeight:700,color:\"var(--ink)\"}}>{Math.round(opa*100)}%</span>\n                  </div>\n                  <input type=\"range\" min={0.3} max={1} step={0.05} value={opa} onChange={e=>setOpa(parseFloat(e.target.value))} style={{width:\"100%\",accentColor:color.border}}/>\n                </div>\n              </div>\n\n              {/* PDF canvas */}\n              <div style={{display:\"flex\",justifyContent:\"center\",padding:\"24px 0\",background:\"var(--surface-2)\",borderRadius:12,border:\"1px solid var(--line)\"}}>\n                <div ref={contRef} style={{position:\"relative\",display:\"inline-block\",boxShadow:\"0 10px 30px -10px rgba(43,33,24,.35), 0 0 0 1px var(--line-strong)\",borderRadius:4,cursor:drag?\"grabbing\":resizing?\"nwse-resize\":\"default\",background:\"#fff\"}}>\n                  <canvas ref={cvRef} style={{display:\"block\",borderRadius:4}}/>\n                  {/* draggable stamp */}\n                  <div onMouseDown={onMD} onTouchStart={onTS} onTouchMove={onTM} onTouchEnd={()=>{ setDrag(false); setResizing(false); }}\n                       style={{position:\"absolute\",left:pos.x,top:pos.y,width:dispSz,height:dispSz,cursor:drag?\"grabbing\":\"grab\",opacity:opa,userSelect:\"none\",touchAction:\"none\",filter:`drop-shadow(0 4px 12px ${color.border}55)`,transform:`rotate(${rot}deg)`}}>\n                    <StampSVG cfg={cfg} size={dispSz}/>\n                    {/* selection ring while dragging */}\n                    {(drag||resizing) && <div style={{position:\"absolute\",inset:-4,border:`1.5px dashed ${color.border}`,borderRadius:6,pointerEvents:\"none\"}}/>}\n                    {/* resize handle */}\n                    <div onMouseDown={e=>startResize(e,e.clientX,e.clientY)}\n                         onTouchStart={e=>{ const t=e.touches[0]; startResize(e,t.clientX,t.clientY); }}\n                         title=\"Redimensionner\"\n                         style={{position:\"absolute\",right:-6,bottom:-6,width:16,height:16,borderRadius:4,background:color.border,border:\"2px solid #fff\",cursor:\"nwse-resize\",boxShadow:\"0 2px 6px rgba(0,0,0,.25)\"}}/>\n                  </div>\n                  {/* guide lines */}\n                  {(drag||resizing) && <>\n                    <div style={{position:\"absolute\",left:pos.x+dispSz/2-.5,top:0,width:1,height:cvSz.h,background:color.border,opacity:.25,pointerEvents:\"none\"}}/>\n                    <div style={{position:\"absolute\",left:0,top:pos.y+dispSz/2-.5,width:cvSz.w,height:1,background:color.border,opacity:.25,pointerEvents:\"none\"}}/>\n                  </>}\n                  {/* size badge while resizing */}\n                  {resizing && <div style={{position:\"absolute\",left:pos.x+dispSz+8,top:pos.y,background:\"var(--ink)\",color:\"#fff\",fontSize:11,fontWeight:700,padding:\"3px 8px\",borderRadius:6,pointerEvents:\"none\",whiteSpace:\"nowrap\"}}>{stampPt} pt</div>}\n                </div>\n              </div>\n\n              <div style={{textAlign:\"center\",fontSize:12,color:\"var(--ink-soft)\",marginTop:12,marginBottom:18}}>\n                Glissez pour déplacer · flèches du clavier pour ajuster (⇧ + flèche = 10 px) · tirez le coin pour redimensionner\n              </div>\n\n              {/* Apply scope */}\n              {totalPg > 1 && (\n                <div style={{marginBottom:14,padding:\"14px 16px\",background:\"var(--surface-2)\",borderRadius:11,border:\"1px solid var(--line)\"}}>\n                  <div style={{fontSize:11,fontWeight:700,letterSpacing:.8,color:\"var(--ink-soft)\",textTransform:\"uppercase\",marginBottom:10}}>Appliquer sur</div>\n                  <div style={{display:\"flex\",gap:6,marginBottom:applyMode===\"range\"?12:0}}>\n                    {[\n                      [\"current\", `Page courante (${pageNum})`],\n                      [\"all\",     `Toutes (${totalPg})`],\n                      [\"range\",   \"Plage…\"],\n                    ].map(([id, lbl]) => (\n                      <button key={id} onClick={()=>setApplyMode(id)} style={{\n                        flex:1, padding:\"8px 6px\", borderRadius:9, fontSize:12, fontWeight:600, cursor:\"pointer\",\n                        background: applyMode===id ? \"var(--ink)\" : \"#fff\",\n                        color: applyMode===id ? \"#fff\" : \"var(--ink-soft)\",\n                        border: `1px solid ${applyMode===id ? \"var(--ink)\" : \"var(--line-strong)\"}`,\n                      }}>{lbl}</button>\n                    ))}\n                  </div>\n                  {applyMode === \"range\" && (\n                    <div style={{display:\"flex\",alignItems:\"center\",gap:8,fontSize:13,color:\"var(--ink-soft)\"}} className=\"fade-in\">\n                      <span>De</span>\n                      <input type=\"number\" min={1} max={totalPg} value={rangeFrom}\n                             onChange={e=>setRangeFrom(Math.max(1,Math.min(totalPg,parseInt(e.target.value)||1)))}\n                             style={{width:64,padding:\"6px 8px\",borderRadius:8,border:\"1px solid var(--line-strong)\",background:\"#fff\",fontSize:13,textAlign:\"center\"}}/>\n                      <span>à</span>\n                      <input type=\"number\" min={1} max={totalPg} value={rangeTo}\n                             onChange={e=>setRangeTo(Math.max(1,Math.min(totalPg,parseInt(e.target.value)||1)))}\n                             style={{width:64,padding:\"6px 8px\",borderRadius:8,border:\"1px solid var(--line-strong)\",background:\"#fff\",fontSize:13,textAlign:\"center\"}}/>\n                      <span style={{marginLeft:\"auto\",fontSize:12,color:\"var(--ink-faint)\"}}>{Math.max(0, Math.min(totalPg,rangeTo) - Math.min(totalPg,rangeFrom) + 1)} page{(rangeTo-rangeFrom)!==0?\"s\":\"\"}</span>\n                    </div>\n                  )}\n                </div>\n              )}\n\n              {/* Status message */}\n              {msg && <div style={{\n                marginBottom:14,padding:\"11px 14px\",borderRadius:10,fontSize:13,\n                color: msg.startsWith(\"Erreur\") ? \"#8a1a1a\" : msg.startsWith(\"PDF\") ? \"#0e5c2f\" : \"var(--ink)\",\n                background: msg.startsWith(\"Erreur\") ? \"#fdf2f2\" : msg.startsWith(\"PDF\") ? \"#eefaf2\" : \"var(--surface-2)\",\n                border: `1px solid ${msg.startsWith(\"Erreur\") ? \"#f5c0c0\" : msg.startsWith(\"PDF\") ? \"#a8e0bc\" : \"var(--line-strong)\"}`,\n                display:\"flex\",alignItems:\"center\",gap:8,\n              }} className=\"fade-in\">\n                {busy && <div style={{width:14,height:14,border:\"2px solid currentColor\",borderTopColor:\"transparent\",borderRadius:\"50%\",animation:\"spin 1s linear infinite\"}}/>}\n                {msg}\n              </div>}\n\n              {/* Download CTA */}\n              <PrimaryButton onClick={applyStamp} disabled={!pdfFile||busy||!libsOk} color={color.border}>\n                {busy ? \"Traitement en cours…\" : (targetPages.length > 1 ? `Télécharger le PDF (${targetPages.length} pages tamponnées)` : \"Télécharger le PDF tamponné\")}\n              </PrimaryButton>\n            </div>\n          )}\n        </section>\n      </div>\n\n      {/* ━━━━━━━ Templates modal ━━━━━━━ */}\n      {showTpls && (\n        <div onClick={()=>setShowTpls(false)} style={{position:\"fixed\",inset:0,background:\"rgba(43,33,24,.4)\",display:\"flex\",alignItems:\"center\",justifyContent:\"center\",zIndex:50,padding:20}} className=\"fade-in\">\n          <div onClick={e=>e.stopPropagation()} style={{background:\"var(--surface)\",borderRadius:16,boxShadow:\"0 30px 60px rgba(0,0,0,.3)\",width:\"100%\",maxWidth:520,maxHeight:\"80vh\",display:\"flex\",flexDirection:\"column\",overflow:\"hidden\"}}>\n            <div style={{padding:\"20px 24px\",borderBottom:\"1px solid var(--line)\",display:\"flex\",alignItems:\"center\",justifyContent:\"space-between\"}}>\n              <div>\n                <div style={{fontSize:18,fontWeight:700,color:\"var(--ink)\",fontFamily:\"'Instrument Serif', serif\"}}>Mes tampons enregistrés</div>\n                <div style={{fontSize:12,color:\"var(--ink-soft)\",marginTop:2}}>{templates.length} template{templates.length>1?\"s\":\"\"}</div>\n              </div>\n              <button onClick={()=>setShowTpls(false)} style={{width:32,height:32,borderRadius:8,border:\"1px solid var(--line-strong)\",background:\"#fff\",cursor:\"pointer\",fontSize:18,color:\"var(--ink-soft)\"}}>×</button>\n            </div>\n            <div style={{padding:20,overflowY:\"auto\",flex:1}}>\n              {templates.length === 0 ? (\n                <div style={{padding:40,textAlign:\"center\",color:\"var(--ink-faint)\"}}>\n                  <div style={{fontSize:13,marginBottom:6}}>Aucun template pour l'instant</div>\n                  <div style={{fontSize:12}}>Cliquez sur \"Enregistrer comme template\" sous l'aperçu pour en créer un.</div>\n                </div>\n              ) : (\n                <div style={{display:\"grid\",gridTemplateColumns:\"1fr 1fr\",gap:12}}>\n                  {templates.map(tpl=>{\n                    const tplCfg = {shape:tpl.shape,color:tpl.ci < COLORS.length ? COLORS[tpl.ci] : hexToColor(tpl.customHex || '#e53e3e'),font:FONTS[tpl.fi],mainText:tpl.main,subText:tpl.sub,dateText:tpl.date,tvaText:tpl.tva,mainFs:tpl.mainFs,subFs:tpl.subFs,dateFs:tpl.dateFs,tvaFs:tpl.tvaFs};\n                    return (\n                      <div key={tpl.id} style={{padding:14,borderRadius:12,background:\"var(--surface-2)\",border:\"1px solid var(--line)\",display:\"flex\",flexDirection:\"column\",gap:10,alignItems:\"center\"}}>\n                        <div style={{padding:8,background:\"#fff\",borderRadius:8,border:\"1px solid var(--line)\"}}><StampSVG cfg={tplCfg} size={100}/></div>\n                        <div style={{fontSize:12,fontWeight:700,color:\"var(--ink)\",textAlign:\"center\",overflow:\"hidden\",textOverflow:\"ellipsis\",whiteSpace:\"nowrap\",width:\"100%\"}} title={tpl.name}>{tpl.name}</div>\n                        <div style={{display:\"flex\",gap:6,width:\"100%\"}}>\n                          <button onClick={()=>loadTemplate(tpl)} style={{flex:1,padding:\"7px 10px\",borderRadius:8,border:\"none\",background:\"var(--ink)\",color:\"#fff\",fontWeight:600,fontSize:12,cursor:\"pointer\"}}>Charger</button>\n                          <button onClick={()=>deleteTemplate(tpl.id)} style={{padding:\"7px 10px\",borderRadius:8,border:\"1px solid var(--line-strong)\",background:\"#fff\",color:\"#c0392b\",fontWeight:600,fontSize:12,cursor:\"pointer\"}}>×</button>\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n\nReactDOM.createRoot(document.getElementById(\"root\")).render(<App/>);\n</script>\n\n\n</body></html>"